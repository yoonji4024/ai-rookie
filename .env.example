# Server only. Copy to .env in the repository root; never put keys in VITE_*.
AX_API_KEY=
SOLAR_API_KEY=
VARCO_API_KEY=
EXAONE_API_KEY=
EXAONE_ENDPOINT_ID=
MIDM_API_KEY=
MIDM_MODEL_ID=midm-pro-fp8-kaic
# Optional private reference files; absent files remain unavailable (no fake score).
# SCORING_MODEL_PATH=/absolute/private/path/scoring_model_hybrid.json
# CONTENT_SCORING_MODEL_PATH=/absolute/private/path/scoring_model_content_hybrid.json
# Optional account/recording store, defaults to data/memflix/private.
# MEMFLIX_DATA_DIR=/absolute/private/path/memflix
# Only explicit offline tests should enable mock LLM mode.
LLM_MOCK=0
